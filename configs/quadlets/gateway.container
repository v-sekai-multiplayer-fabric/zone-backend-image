[Unit]
Description=zone-backend WebTransport gateway
Documentation=https://github.com/v-sekai-multiplayer-fabric/zone-backend
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/v-sekai-multiplayer-fabric/zone-backend:latest
ContainerName=gateway
PublishPort=443:443/udp
Volume=/etc/gateway/db-certs:/etc/gateway/db-certs:ro,Z
Volume=/etc/gateway/tls:/etc/gateway/tls:ro,Z
EnvironmentFile=/etc/gateway/env
# UDP/443 needs CAP_NET_BIND_SERVICE in rootful podman; rootless would
# need extra capability handling. Run as root container for now.
AddCapability=NET_BIND_SERVICE

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
